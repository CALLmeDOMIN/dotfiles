# See dunst(5) for all configuration options
# Catppuccin Mocha (Mauve accent) theme, matching hyprland/hyprtoolkit/waybar

[global]
    monitor = 0
    follow = none

    width = 320
    height = (0, 200)
    origin = top-right
    offset = (16, 16)
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 5
    progress_bar_corners = all

    icon_corner_radius = 6
    icon_corners = all

    indicate_hidden = yes
    transparency = 0
    separator_height = 1
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 10

    frame_width = 2
    frame_color = "#b4befe"
    separator_color = frame

    sort = yes
    idle_threshold = 120

    font = JetBrainsMono Nerd Font 11
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    enable_posix_regex = false

    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark
    icon_position = left
    min_icon_size = 32
    max_icon_size = 96

    sticky_history = yes
    history_length = 20

    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst

    corner_radius = 10
    corners = all
    ignore_dbusclose = false

    force_xwayland = false
    force_xinerama = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false
    pause_on_mouse_over = false
    enable_pcre_regex = false

[urgency_low]
    background = "#1e1e2ed9"
    foreground = "#a6adc8"
    frame_color = "#585b70"
    timeout = 5
    default_icon = dialog-information

[urgency_normal]
    background = "#1e1e2ed9"
    foreground = "#cdd6f4"
    frame_color = "#b4befe"
    timeout = 8
    default_icon = dialog-information

[urgency_critical]
    background = "#1e1e2ef2"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
    default_icon = dialog-warning

# Existing app-specific rule, kept as-is
[gamemode-style]
    appname = "gamemode"
    background = "#1a1a2e"
    foreground = "#7aa2f7"
    frame_color = "#7aa2f7"
