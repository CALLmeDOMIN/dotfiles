{
  "layer": "top",
  "position": "top",
  "modules-left": [
    "custom/music",
    "pulseaudio"
  ],

  "modules-center": [
    "hyprland/workspaces",
    "group/performance"
  ],

  "modules-right": [
    "custom/weather",
    "group/connectivity",
    "tray",
    "clock",
    "group/power"
  ],

//  "custom/uptime": (defined below, currently unused)
//  "battery": (currently unused, no battery on this desktop)
//  "custom/docker": (defined below, currently unused - re-add to a group if wanted)

  "group/performance": {
    "orientation": "inherit",
    "modules": ["cpu", "memory", "custom/gpu"]
  },

  "group/connectivity": {
    "orientation": "inherit",
    "modules": ["network", "bluetooth"]
  },

  "group/power": {
    "orientation": "inherit",
    "modules": ["custom/lock", "custom/power"]
  },

  "hyprland/workspaces": {
    "format": "{name}: {icon}",
    "format-icons": {
      "active": "",
      "default": ""
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10,
    "ignore-list": ["blueman"]
  },

  "custom/music": {
    "format": "  {}",
    "escape": true,
    "interval": 5,
    "tooltip": false,
    "exec": "playerctl metadata --format='{{ artist }} - {{ title }}'",
    "on-click": "playerctl play-pause",
    "max-length": 50
  },

  "clock": {
    "timezone": "Europe/Warsaw",
    "tooltip-format": "<span color='#b4befe'><big><b>{:%Y %B}</b></big></span>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%d/%m/%Y - %H:%M:%S}",
    "interval": 1,
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#cba6f7'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'>{}</span>",
        "weekdays": "<span color='#89b4fa'><b>{}</b></span>",
        "today": "<span color='#11111b' background='#b4befe'><b><u>{}</u></b></span>"
      }
    }
  },

  "network": {
    "format-wifi": "󰤢 ",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰤠 ",
    "interval": 5,
    "tooltip": false,
    "on-click": "networkmanager_dmenu"
  },

  "bluetooth": {
    "format": " {status}",
    "format-disabled": " off",
    "format-off": " off",
    "format-on": " on",
    "format-no-controller": " no ctrl",
    "format-connected": " {device_alias}",
    "format-connected-battery": " {device_alias} {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "blueman-manager"
  },

  "cpu": {
    "interval": 2,
    "format": " {usage:>3}%"
  },


  "memory": {
    "interval": 30,
    "format": " {percentage:>3}%"
  },

  "custom/gpu": {
    "format": "{}",
    "tooltip": true,
    "interval": 5,
    "exec": "~/dotfiles/scripts/gpu-stats/gpu-stats",
    "return-type": "json"
  },

  "custom/uptime": {
    "format": "{}",
    "interval": 1600,
    "exec": "sh -c '(uptime -p)'"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", " "]
    },
    "on-click": "pavucontrol"
  },

  "custom/lock" : {
    "tooltip": false,
    "on-click": "sh -c '(sleep 0.5s; hyprlock)' & disown",
    "format": ""
  },

  "custom/power": {
    "tooltip": false,
    "on-click": "wlogout -b 2 &",
    "format": "⏻"
  },

  "custom/docker": {
    "format": "{}",
    "return-type": "json",
    "interval": 10,
    "exec": "~/dotfiles/scripts/docker-stats/docker-stats",
    "tooltip": true
  },

  "custom/weather": {
    "format": "{}",
    "tooltip": true,
    "interval": 1800,
    "exec": "~/dotfiles/scripts/weather-stats/weather-stats",
    "return-type": "json"
  }
}
