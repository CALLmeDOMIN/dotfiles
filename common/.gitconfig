[user]
    name = Dominik Sieroń
[alias]
    alias = !git config --get-regexp '^alias\\.' | grep -v '^alias\\.alias\\b'
    st = status
    sw = switch
    swtich = switch
    fo = fetch origin
    conf = config --global --edit
    cge = config --global --edit
    co = commit
    ch = checkout
    chd = checkout .
    cb = checkout -b
    rh = reset HEAD
    aa = add -A
    cdf = clean -df
    br = branch
    bra = branch -a
    pr = pull --rebase
    amend = commit -a --amend --no-edit
    coam = commit -a --amend --no-edit
    wtls = worktree list
[init]
    defaultBranch = main

# OS-specific settings (editor, credential helper) - provided by the macos/ or linux/ stow package
[include]
    path = ~/.gitconfig-os

# Identity (work vs personal email) - untracked, symlinked once per machine to
# either ~/dotfiles/common/.gitconfig-work or ~/dotfiles/common/.gitconfig-personal.
# See install.sh.
[include]
    path = ~/.gitconfig-identity

# dotfiles itself is a personal repo - always personal identity, regardless of
# machine default (overrides the include above since it's evaluated after it).
[includeIf "gitdir:**/dotfiles/"]
    path = ~/dotfiles/common/.gitconfig-personal
