# Linux-specific zsh additions (counterpart to macos/.zshrc-os), sourced from
# common/.zshrc. Populated during the arch migration with the bits of arch's
# old standalone .zshrc that didn't survive reconciliation into common/.

# asdf: resolved. This machine has no asdf (no ~/.asdf, nothing on PATH) - it
# uses fnm for node and pacman for everything else. common/.zshrc's asdf
# shims/completions lines are harmless no-ops here, so there is nothing to
# source. If asdf is ever adopted on arch, add its init below.

# fnm (node version manager; pacman-installed binary, shells live under
# $XDG_DATA_HOME). Was hardcoded to /home/cmdarch in arch's old .zshrc.
FNM_PATH="$HOME/.local/share/fnm"
if [ -d "$FNM_PATH" ]; then
  export PATH="$FNM_PATH:$PATH"
  eval "$(fnm env)"
fi

# pnpm (same - was hardcoded to /home/cmdarch)
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# Provisioning scripts. scripts/ is stow-ignored, so these run out of the repo
# rather than $HOME, and they moved down into linux/ with the restructure.
alias dev="$HOME/dotfiles/linux/scripts/dev.sh"
alias devyay="$HOME/dotfiles/linux/scripts/dev-yay.sh"

# Arch ships Zed's binary as `zeditor` - plain `zed` belongs to the ZFS Event
# Daemon (zfs-utils). Homebrew installs it as `zed` on macOS, so this rename
# has to live here rather than in common/.zshrc, which calls `zed .` from the
# wt() and wts() worktree helpers.
alias zed=zeditor

# Graceful uwsm-aware power actions (hyprshutdown is AUR, Hyprland-only).
# Note: 'reboot' deliberately shadows /usr/bin/reboot, as it did on arch.
alias bye="hyprshutdown -t 'Shutting down...' --post-cmd 'shutdown -P 0'"
alias reboot="hyprshutdown -t 'Restarting...' --post-cmd 'reboot'"

# Carried over from arch's .zshrc. Not actually Linux-only - promote to
# common/.zshrc if the other machines want them too.
bindkey "^R" history-incremental-search-backward
set +H   # no history expansion; '!' stays literal

# Note: arch's old .zshrc used vi mode (bindkey -v). Deliberately NOT carried
# over - emacs mode from common/.zshrc is the wanted behaviour on all machines.
