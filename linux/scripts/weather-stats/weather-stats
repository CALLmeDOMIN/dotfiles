#!/usr/bin/env bash
# Waybar custom/weather module. No API key needed (open-meteo.com).
# Outputs waybar's custom-module JSON format; "class" matches the
# custom-weather.* selectors in waybar/style.css.

LAT=50.0647
LON=19.9450

response=$(curl -s --max-time 10 \
    "https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LON}&current_weather=true")

if [ -z "$response" ]; then
    jq -nc '{text: "", tooltip: "Weather unavailable", class: "error"}'
    exit 0
fi

temp=$(jq -r '.current_weather.temperature // "?"' <<<"$response")
code=$(jq -r '.current_weather.weathercode // -1' <<<"$response")
wind=$(jq -r '.current_weather.windspeed // "?"' <<<"$response")

case "$code" in
    0)                                  icon="";   class="clear";   desc="Clear sky" ;;
    1|2|3)                              icon="";   class="cloud";   desc="Partly cloudy" ;;
    45|48)                              icon="";     class="fog";     desc="Fog" ;;
    51|53|55|56|57|61|63|65|66|67|80|81|82) icon=""; class="rain";   desc="Rain" ;;
    71|73|75|77|85|86)                  icon="";    class="snow";    desc="Snow" ;;
    95|96|99)                           icon=""; class="thunder"; desc="Thunderstorm" ;;
    *)                                  icon="";   class="error";   desc="Unknown" ;;
esac

tooltip=$(printf '%s\nWind: %s km/h' "$desc" "$wind")

jq -nc \
    --arg text "${icon}  ${temp}°C" \
    --arg tooltip "$tooltip" \
    --arg class "$class" \
    '{text: $text, tooltip: $tooltip, class: $class}'
