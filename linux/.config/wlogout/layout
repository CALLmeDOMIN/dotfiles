{
    "label" : "lock",
    "action" : "hyprlock",
    "keybind" : "l"
}
{
    "label" : "reboot",
    "action" : "hyprshutdown -t \"Restarting...\" --vt 1 --post-cmd \"reboot\"",
    "keybind" : "r"
}

{
    "label" : "logout",
    "action" : "hyprshutdown -t \"Logging out...\"",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "hyprshutdown -t \"Shutting down...\" --vt 1 --post-cmd \"shutdown -P 0\"",
    "keybind" : "s"
}
